// Cloudflare Workers static site: `npm run build:cover` writes the page to dist/, `wrangler deploy` uploads it.
{
  "name": "sweetaquarell",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
